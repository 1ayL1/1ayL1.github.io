[{"title":"2025.10.31","url":"/2025/11/02/10-31/","content":"\n\n  \n  \n    \n      \n      \n        My Birthday\n      \n    \n  \n\n\n\nimport {initHBE} from \"/js/plugins/hbe.js\";\n  console.log(\"hexo-blog-encrypt: loaded.\");\n    initHBE();\n\n","categories":["我"],"tags":["随想随记"]},{"title":"第一篇","url":"/2025/04/07/first/","content":"\n\n  \n  \n    \n      \n      \n        Hey, password is required here.\n      \n    \n  \n\n\n\nimport {initHBE} from \"/js/plugins/hbe.js\";\n  console.log(\"hexo-blog-encrypt: loaded.\");\n    initHBE();\n\n","categories":["测试"],"tags":["test"]},{"title":"Hello World","url":"/2025/04/07/hello-world/","content":"Welcome to Hexo! This is your very first post. Check documentation for more info. If you get any problems when using Hexo, you can find the answer in troubleshooting or you can ask me on GitHub.\nQuick StartCreate a new post$ hexo new &quot;My New Post&quot;\n\nMore info: Writing\nRun server$ hexo server\n\nMore info: Server\nGenerate static files$ hexo generate\n\nMore info: Generating\nDeploy to remote sites$ hexo deploy\n\nMore info: Deployment\n"},{"title":"记今日惊喜","url":"/2025/04/07/lucky1/","content":"遇到了一个超级超级超级无敌好的人\n为我做了一件我感觉超级超级超级快乐的事儿\n幸运的一天\n幸运的我\n美好的人和事儿\n喜欢喜欢~yy\n","categories":["生活"],"tags":["小确幸"]},{"title":"保持清醒！","url":"/2025/04/08/%E4%BB%8A%E6%97%A5%E7%A2%8E%E7%A2%8E%E5%BF%B5/","content":"学会放手\n保持清醒\n好好学习（打起精神来！）\n这破天怎么这么让人想睡觉\n困困困~\n","categories":["生活"],"tags":["碎碎念"]},{"title":"喜欢自己好不好","url":"/2025/04/13/%E5%96%9C%E6%AC%A2%E8%87%AA%E5%B7%B1%E5%A5%BD%E4%B8%8D%E5%A5%BD/","content":"\n\n  \n  \n    \n      \n      \n        My Birthday\n      \n    \n  \n\n\n\nimport {initHBE} from \"/js/plugins/hbe.js\";\n  console.log(\"hexo-blog-encrypt: loaded.\");\n    initHBE();\n\n","categories":["悲伤的小事"],"tags":["不知道"]},{"title":"幸福的泪水","url":"/2025/09/09/%E5%B9%B8%E7%A6%8F%E7%9A%84%E6%B3%AA%E6%B0%B4/","content":"\n\n  \n  \n    \n      \n      \n        sister\n      \n    \n  \n\n\n\nimport {initHBE} from \"/js/plugins/hbe.js\";\n  console.log(\"hexo-blog-encrypt: loaded.\");\n    initHBE();\n\n","categories":["幸福"],"tags":["happy&love&lucky"]},{"title":"幸福？","url":"/2025/05/06/%E5%B9%B8%E7%A6%8F%EF%BC%9F/","content":"\n\n  \n  \n    \n      \n      \n        特殊的一天\n      \n    \n  \n\n\n\nimport {initHBE} from \"/js/plugins/hbe.js\";\n  console.log(\"hexo-blog-encrypt: loaded.\");\n    initHBE();\n\n","categories":["tongku"],"tags":["like"]},{"title":"讨厌与开心","url":"/2025/06/29/%E8%AE%A8%E5%8E%8C/","content":"讨厌下雨天\n潮湿的空气\n阴暗的天空\n不能忍受\n不想出门\n只想睡觉（睡觉尊嘟好舒服 ~ ~，但最近总是做梦，睡得不安稳，不想做梦了，不想做一些梦了）\n给了自己充分的不学习的理由\n嘻嘻嘻嘻嘻\n但好开心，每次不开心的时候总是会被朋友治愈得很好，好喜欢我的朋友萌~\n","categories":["自我"],"tags":["讨厌与开心"]},{"title":"这一刻的我与我","url":"/2025/07/01/%E8%BF%99%E4%B8%80%E5%88%BB%E7%9A%84%E6%88%91%E4%B8%8E%E6%88%91/","content":"\n\n  \n  \n    \n      \n      \n        特殊的一天\n      \n    \n  \n\n\n\nimport {initHBE} from \"/js/plugins/hbe.js\";\n  console.log(\"hexo-blog-encrypt: loaded.\");\n    initHBE();\n\n"}]